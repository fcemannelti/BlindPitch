# Servidor local (desenvolvimento)
PORT=3000
HOST=127.0.0.1
SERVE_DIST=false
COOKIE_SECURE=false

# Banco de dados
# Sem DATABASE_URL a aplicação usa SQLite em ./data/blindpitch.sqlite.
# Com DATABASE_URL ela usa PostgreSQL (produção / Vercel).
# DATABASE_URL=postgresql://USUARIO:SENHA@host.neon.tech/neondb?sslmode=require
# DATABASE_PATH=./data/blindpitch.sqlite
# Limite de conexões do pool por instância (Vercel). Menor é melhor no plano grátis.
# PGPOOL_MAX=4

# Base real (sem demonstração). Exige senha do organizador com 12+ caracteres.
DEMO_MODE=true
# ADMIN_EMAIL=organizacao@exemplo.com
# ADMIN_PASSWORD=

# Testes PostgreSQL. Aponta para um banco descartável; a suíte cria e
# remove um banco temporário por execução. Sem esta variável a suíte
# PostgreSQL é ignorada.
# BLINDPITCH_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
